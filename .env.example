# Tudo é opcional: sem a variável, o SDK correspondente NÃO é carregado (custo zero).
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0

# Sentry (erros + performance)
VITE_SENTRY_DSN=

# OpenTelemetry (traces via OTLP/HTTP — ex.: https://otel.seudominio.com/v1/traces)
VITE_OTEL_ENDPOINT=

# Datadog RUM
VITE_DD_APPLICATION_ID=
VITE_DD_CLIENT_TOKEN=
VITE_DD_SITE=datadoghq.com

# New Relic Browser (URL do loader gerado no painel do New Relic)
VITE_NEWRELIC_LOADER_URL=
