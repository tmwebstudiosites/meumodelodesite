{
  "name": "modas-a-rigor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site da Modas a Rigor Ateliê — Noivas e Festa",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "images": "node scripts/optimize-images.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "mutation": "stryker run",
    "check": "npm run lint && npm run typecheck && npm run arch && npm run knip && npm run test:cov",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@biomejs/biome": "^2.6.9",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "dependency-cruiser": "^18.9.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "knip": "^6.48.0",
    "sharp": "^0.35.5",
    "typescript": "5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@datadog/browser-rum": "^7.19.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation-fetch": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-trace-web": "^2.12.1",
    "@sentry/browser": "^11.17.0",
    "web-vitals": "^6.2.3"
  }
}
